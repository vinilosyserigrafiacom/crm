# Base de datos. Por defecto SQLite en un fichero, que es lo más simple para
# un taller: un único fichero que se puede copiar como copia de seguridad.
# Para PostgreSQL: cambia el provider en prisma/schema.prisma a "postgresql" y
# usa una URL del tipo postgresql://usuario:clave@host:5432/crm
DATABASE_URL="file:./dev.db"

# Clave para firmar las cookies de sesión. OBLIGATORIO cambiarla en producción.
# Genera una con: openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# URL pública de la aplicación (se usa en enlaces y cookies seguras).
APP_URL="http://localhost:3000"

# --- WooCommerce (opcional) -------------------------------------------------
# Conexión con la tienda para importar clientes y pedidos. La información va en
# un solo sentido: el CRM nunca escribe nada en WooCommerce.
#
# Las claves se generan en la tienda, en WooCommerce → Ajustes → Avanzado →
# API REST, con permiso de SOLO LECTURA: el CRM no necesita más.
#
# Van aquí y no en la base de datos a propósito: una clave de la tienda permite
# leer todo el fichero de clientes, y guardarla en la base de datos la metería
# en cualquier copia de seguridad.
# WOO_URL="https://vinilosyserigrafia.com"
# WOO_CONSUMER_KEY="ck_..."
# WOO_CONSUMER_SECRET="cs_..."
